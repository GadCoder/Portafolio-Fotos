{
  "name": "portfolio-photos-admin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @portfolio-photos/contracts build && vite --host 0.0.0.0",
    "build": "pnpm --filter @portfolio-photos/contracts build && pnpm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "pnpm --filter @portfolio-photos/contracts build && tsc --noEmit",
    "test": "pnpm --filter @portfolio-photos/contracts build && vitest run"
  },
  "dependencies": {
    "@portfolio-photos/contracts": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^7.1.7",
    "vitest": "^5.0.4"
  }
}
